# ==============================================================================
# Framefolio configuration
#
# Copy this file to `.env` and edit it. It must sit next to the compose file
# you use (compose.image.yml or docker-compose.yml).
#
# Local storage is the default: you do NOT need any FRAMEFOLIO_S3_* variable
# unless you want to serve images from object storage / a CDN.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------------------

# Admin password. Used to sign in at /admin.
#
# If this is left empty, the admin API returns 404 and the /admin page shows
# "admin not enabled". The public gallery is NOT affected and stays reachable.
FRAMEFOLIO_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# LINUX / NAS: check these
# ------------------------------------------------------------------------------

# The identity the container runs as. Files written into ./data are owned by
# these IDs.
#
# If your host user is not 1000, you MUST set these to match, or the sync fails
# with a permission error. Find the right values with:
#
#   id -u    # e.g. 1026  -> PUID=1026
#   id -g    # e.g. 100   -> PGID=100
#
# On macOS / Windows with Docker Desktop the mounts do not enforce the UID, so
# the defaults are normally fine.
#
# Note: this affects BOTH the gallery container (upload / delete / sync from
# /admin) and the sync container (command line). It is not a CLI-only setting.
PUID=1000
PGID=1000

# ------------------------------------------------------------------------------
# COMMON OPTIONS
# ------------------------------------------------------------------------------

# Port to expose on the host.
FRAMEFOLIO_PORT=3123

# Image to run. Pinning a version is recommended over `latest`.
# - Prebuilt image from Docker Hub (compose.image.yml):
FRAMEFOLIO_IMAGE=wungjyan/framefolio:latest
# - Locally built image (docker-compose.yml) — uncomment instead:
# FRAMEFOLIO_IMAGE=framefolio:local

# How long a login stays valid, in seconds. Default 604800 (7 days).
FRAMEFOLIO_SESSION_TTL=

# Signing key for the login cookie. Leave empty to derive it from the admin
# password. Set it explicitly to invalidate all existing sessions without
# changing the password.
FRAMEFOLIO_SESSION_SECRET=

# Upload limits. Defaults: 100 MB per file, 120 megapixels per photo.
# Raise the pixel limit if you upload very large files; both protect the server
# from running out of memory while decoding an image.
FRAMEFOLIO_MAX_UPLOAD_BYTES=
FRAMEFOLIO_MAX_UPLOAD_PIXELS=

# ------------------------------------------------------------------------------
# ADVANCED: OBJECT STORAGE / CDN
#
# Leave everything below unset for local-only operation. Syncing then writes
# local files only and makes no network uploads at all.
#
# When these are set, every sync uploads the generated images to the bucket,
# regardless of which source is currently active. That is what makes switching
# sources instant and needs no re-sync.
# ------------------------------------------------------------------------------

# Initial source: `local` or `r2`. The admin UI can change this at runtime; the
# choice is then stored in data/.state/storage.json and takes precedence here.
FRAMEFOLIO_STORAGE_SOURCE=local

# S3-compatible endpoint. For Cloudflare R2:
#   https://<account-id>.r2.cloudflarestorage.com
FRAMEFOLIO_S3_ENDPOINT=
# R2 uses `auto`. Other providers take a real region such as `us-east-1`.
FRAMEFOLIO_S3_REGION=auto
FRAMEFOLIO_S3_BUCKET=
FRAMEFOLIO_S3_ACCESS_KEY_ID=
FRAMEFOLIO_S3_SECRET_ACCESS_KEY=

# Public base URL used to build image URLs. This is only a string prefix, so any
# value works; prefer a custom domain over r2.dev, which is rate-limited and not
# served through the CDN cache.
FRAMEFOLIO_S3_PUBLIC_BASE_URL=

# Optional key prefix, for sharing one bucket between several sites.
FRAMEFOLIO_S3_PREFIX=

# Set to true for MinIO and most self-hosted S3 servers, which address buckets
# by path (host/bucket/key) instead of by subdomain.
FRAMEFOLIO_S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# SOURCE-CODE ONLY
#
# Needed only when running from source or building the image yourself. Ignore
# these if you deploy the prebuilt image.
# ------------------------------------------------------------------------------

# Where the runtime data directory lives. Defaults to ./data.
NUXT_GALLERY_DATA_DIR=./data

# npm registry used while building the image. Useful behind a slow or blocked
# connection to registry.npmjs.org.
NPM_REGISTRY=https://registry.npmmirror.com
