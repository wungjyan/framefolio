# Local development
NUXT_GALLERY_DATA_DIR=./data

# Docker Compose
FRAMEFOLIO_PORT=3123
FRAMEFOLIO_IMAGE=framefolio:local
NPM_REGISTRY=https://registry.npmmirror.com
PUID=1000
PGID=1000

# --- Admin area -----------------------------------------------------------------
# The admin area is DISABLED (returns 404) unless a password is set here.
# Open it by typing /admin in your browser; there is no link from the gallery.
FRAMEFOLIO_ADMIN_PASSWORD=

# Optional. Signs session cookies. Defaults to the admin password, so a
# single-password setup needs no extra configuration. Set it explicitly to allow
# rotating sessions without changing the password.
FRAMEFOLIO_SESSION_SECRET=

# Optional. Session lifetime in seconds. Default 604800 (7 days).
FRAMEFOLIO_SESSION_TTL=

# Optional upload limits. Defaults: 100 MB per file, 120 megapixels.
FRAMEFOLIO_MAX_UPLOAD_BYTES=
FRAMEFOLIO_MAX_UPLOAD_PIXELS=

# --- Storage source -------------------------------------------------------------
# `local` serves images from this machine. `r2` serves them from object storage.
# This is only the initial value: once you switch in the admin UI the choice is
# stored in data/.state/storage.json and takes precedence over this variable.
FRAMEFOLIO_STORAGE_SOURCE=local

# --- Object storage (Cloudflare R2, or any S3-compatible service) ---------------
# Derivatives are uploaded during every sync whenever these are set, regardless
# of the active source, so switching sources is instant and needs no re-sync.
FRAMEFOLIO_S3_ENDPOINT=
FRAMEFOLIO_S3_REGION=auto
FRAMEFOLIO_S3_BUCKET=
FRAMEFOLIO_S3_ACCESS_KEY_ID=
FRAMEFOLIO_S3_SECRET_ACCESS_KEY=

# Public base URL used to build image URLs. This is only a string prefix; the
# code does not care what it points at. Prefer a custom domain for CDN caching
# over r2.dev, which is rate-limited and not cached.
FRAMEFOLIO_S3_PUBLIC_BASE_URL=

# Optional key prefix, for sharing one bucket between several sites.
FRAMEFOLIO_S3_PREFIX=

# Set to true for MinIO and most self-hosted S3 servers, which address buckets by
# path (host/bucket/key) instead of by subdomain.
FRAMEFOLIO_S3_FORCE_PATH_STYLE=false
