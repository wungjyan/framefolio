{
  "name": "framefolio",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "start": "pnpm exec foo-cli start",
    "build": "pnpm exec foo-cli build",
    "test": "pnpm exec foo-cli test",
    "typecheck": "pnpm exec foo-cli typecheck",
    "postinstall": "pnpm --filter foo-cli run build:cli && pnpm exec foo-cli prepare"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "nuxt": "^4.5.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "foo-cli": "workspace:*",
    "puppeteer": "^25.9.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
